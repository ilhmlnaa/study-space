{
  "info": {
    "name": "StudySpace API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminEmail", "value": "admin@studyspace.test" },
    { "key": "mentorEmail", "value": "mentor@studyspace.test" },
    { "key": "studentEmail", "value": "student@studyspace.test" },
    { "key": "password", "value": "password123" },
    { "key": "csrfToken", "value": "" },
    { "key": "roomId", "value": "" },
    { "key": "roomCode", "value": "" },
    { "key": "pollId", "value": "" },
    { "key": "pollOptionId", "value": "" },
    { "key": "targetUserId", "value": "" },
    { "key": "newUserEmail", "value": "" }
  ],
  "item": [
    {
      "name": "1. Autentikasi",
      "item": [
        {
          "name": "1a. Register User Baru",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ts = Date.now();",
                  "pm.collectionVariables.set('newUserEmail', `test_${ts}@studyspace.test`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Response has user data', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json).to.have.property('email');",
                  "  pm.expect(json.role).to.eql('STUDENT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Student\",\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"password123\",\n  \"confirmPassword\": \"password123\",\n  \"role\": \"STUDENT\"\n}"
            },
            "url": "{{baseUrl}}/api/register"
          }
        },
        {
          "name": "1b. Register Email Duplikat",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Error message correct', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.error).to.include('already exists');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Student\",\n  \"email\": \"student@studyspace.test\",\n  \"password\": \"password123\",\n  \"confirmPassword\": \"password123\",\n  \"role\": \"STUDENT\"\n}"
            },
            "url": "{{baseUrl}}/api/register"
          }
        },
        {
          "name": "1c. Register Validasi Gagal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Response has field errors', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('details');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AB\",\n  \"email\": \"invalid-email\",\n  \"password\": \"123\",\n  \"confirmPassword\": \"456\"\n}"
            },
            "url": "{{baseUrl}}/api/register"
          }
        },
        {
          "name": "1d. Ambil CSRF Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('csrfToken', json.csrfToken);",
                  "console.log('CSRF Token:', json.csrfToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/csrf"
          }
        },
        {
          "name": "1e. Login sebagai Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login berhasil (200 atau redirect)', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});",
                  "pm.test('Session cookie tersimpan', () => {",
                  "  const cookieJar = pm.cookies.toObject();",
                  "  console.log('Cookies:', JSON.stringify(cookieJar));",
                  "  const hasSession = Object.keys(cookieJar).some(k => k.includes('next-auth.session-token') || k.includes('authjs.session-token'));",
                  "  pm.expect(hasSession, 'Session cookie harus ada').to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "csrfToken", "value": "{{csrfToken}}" },
                { "key": "email", "value": "{{adminEmail}}" },
                { "key": "password", "value": "{{password}}" },
                { "key": "redirect", "value": "false" },
                { "key": "callbackUrl", "value": "{{baseUrl}}" },
                { "key": "json", "value": "true" }
              ]
            },
            "url": "{{baseUrl}}/api/auth/callback/credentials"
          }
        },
        {
          "name": "1f. Verifikasi Sesi Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Sesi valid sebagai Admin', () => {",
                  "  const json = pm.response.json();",
                  "  console.log('Session:', JSON.stringify(json));",
                  "  pm.expect(json).to.have.property('user');",
                  "  pm.expect(json.user.email).to.eql('admin@studyspace.test');",
                  "  pm.expect(json.user.role).to.eql('ADMIN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/session"
          }
        }
      ]
    },
