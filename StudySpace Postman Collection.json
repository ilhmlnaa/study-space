          "name": "4e. Ambil CSRF Token (untuk Student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('csrfToken', json.csrfToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/csrf"
          }
        },
        {
          "name": "4f. Login sebagai Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login Student berhasil', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "csrfToken", "value": "{{csrfToken}}" },
                { "key": "email", "value": "{{studentEmail}}" },
                { "key": "password", "value": "{{password}}" },
                { "key": "redirect", "value": "false" },
                { "key": "callbackUrl", "value": "{{baseUrl}}" },
                { "key": "json", "value": "true" }
              ]
            },
            "url": "{{baseUrl}}/api/auth/callback/credentials"
          }
        },
        {
          "name": "4g. Join Room (agar bisa vote)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Join room berhasil', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{roomCode}}\"\n}"
            },
            "url": "{{baseUrl}}/api/rooms/join"
          }
        },
        {
          "name": "4h. Vote Poll",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Vote count terupdate', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.hasVoted).to.be.true;",
                  "  pm.expect(json.userVotedOptionId).to.not.be.null;",
                  "  const votedOption = json.options.find(o => o.id === json.userVotedOptionId);",
                  "  pm.expect(votedOption.voteCount).to.be.greaterThan(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"optionId\": \"{{pollOptionId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/polls/{{pollId}}/vote"
          }
        },
        {
          "name": "4i. Vote Duplikat (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Error message correct', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.error).to.include('already voted');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"optionId\": \"{{pollOptionId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/polls/{{pollId}}/vote"
          }
        }
      ]
    }
  ]
}
